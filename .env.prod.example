# Production settings.

# Plain `docker compose ...` on the server uses the production file.
COMPOSE_FILE=docker-compose.prod.yaml

# The address of the app, e.g. loxofit.app (or <server-ip>.sslip.io until the domain is ready)
DOMAIN=

# Database - pick any user and database name; the password: openssl rand -hex 24
POSTGRES_USER=loxofit
POSTGRES_PASSWORD=
POSTGRES_DB=loxofit

# Signs the access tokens - openssl rand -hex 32. Changing it logs everyone out.
JWT_SECRET=

# Processes generating plans at the same time (the server has 2 vCPU)
GENERATOR_WORKERS=2

# The first admin account
FIRST_SUPERUSER_EMAIL=
FIRST_SUPERUSER_PASSWORD=