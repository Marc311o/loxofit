# --- Database ---
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=db
# POSTGRES_SERVER=db
# POSTGRES_PORT=5432
# SQL_ECHO=false

# --- Security ---
JWT_SECRET=secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false

# --- First admin  ---
FIRST_SUPERUSER_EMAIL=admin@example.dev
FIRST_SUPERUSER_PASSWORD=password

# --- pgAdmin ---
PGADMIN_EMAIL=admin@example.dev
PGADMIN_PASSWORD=password